{
  "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
  "diagnostics": {
    "globals": [
      "vim"
    ]
  },
  "workspace": {
    "library": [
      "vim.fn.stdpath('data') .. '/lazy'",
      "vim.fn.stdpath('config') .. '/lua'",
      "vim.fn.stdpath('config') .. '/after'"
    ],
    "checkThirdParty": false
  },
  "runtime": {
    "version": "LuaJIT",
    "path": [
      "?.lua",
      "?/init.lua",
      "?/lua/?.lua",
      "?/lua/?/init.lua"
    ]
  }
}