**/*.pfx

# Shell environment files that might contain secrets
zsh/.zshenv
zsh/.zshrc.local
zsh/.zprofile.local

# SSH keys
**/.ssh/id_*
**/.ssh/known_hosts

# GPG keys
**/.gnupg/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

